  [NeZero n] → (A : Type u_1) → [Fintype A] → Finset (ShiftSym.Config n d A) → Prop
ShiftSym.kernelEnumerationStatement : (n d : ℕ) →
  [NeZero n] → (F : Type u_1) → [Field F] → [Fintype F] → (ShiftSym.Lat n d → F) → Prop
ShiftSym.imageDominationStatement : (n d : ℕ) →
